<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<connectionStrings>
		<add name="DatabaseString" connectionString="Server=localhost;Database=NesDB;User Id=sa;Password=sifre123_;TrustServerCertificate=True;" providerName="System.Data.SqlClient" />
		<add name="HangfireConnection" connectionString="Server=localhost;Database=HangfireDb;User Id=sa;Password=sifre123_;TrustServerCertificate=True;" />
	</connectionStrings>
	<appSettings>
		<!-- value="Dependency" veya value="Polling" yapınız.  -->
		<add key="CheckMethod" value="Dependency" />
		<!-- Veritabanı kontrol etme süresi (ms cinsinden). Örn. 10 saniye = 10000 milisaniye. -->
		<add key="Time" value="15000" />
		<!-- Bir request için max tekrar sayısı. -->
		<add key="MaxRetryCount" value="5" />
		<!-- Yeniden denemeler için beklenecek süre (ms cinsinden).-->
		<add key="RetryDelay" value="1000" />
		<!-- Smtp Sağlayıcısını giriniz-->
		<add key="SmtpHost" value="smtp.gmail.com" />
		<!-- Smtp Mailini giriniz-->
		<add key="SmtpMail" value="omerfaruktr82@gmail.com" />
		<!-- Smtp Şifresini giriniz-->
		<add key="SmtpPassword" value="otcr sevg gjyc lfcx" />
		<!-- Firebase Private Key Json pathini giriniz-->
		<add key="ServiceAccountJsonPath" value="serviceAccount.json" />
	</appSettings>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
